# Copy these settings into your shell or hosting provider's environment configuration.
PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret
DATA_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret

# Optional OpenAI-compatible chat provider settings.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_API_URL=https://api.openai.com/v1/chat/completions

# Set for hosting behind a trusted reverse proxy.
TRUST_PROXY=0

# Required only on the first production start when no users exist.
INITIAL_ADMIN_NAME=Workspace Administrator
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
